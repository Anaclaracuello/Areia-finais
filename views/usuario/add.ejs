<%- include('../cabecalho.ejs', { paginaAtiva: '', tituloPagina: 'Cadastro' }) %>
<main class="content-page narrow-page">
  <section class="page-heading"><span class="eyebrow">FAÇA PARTE DA ARENA</span><h1>Crie seu <em>cadastro.</em></h1><p>Cadastre seus dados para poder reservar uma quadra.</p></section>
  <section class="form-card"><form method="post" action="/usuario/add">
    <div class="form-group"><label for="nome">Nome completo</label><input id="nome" type="text" name="nome" required></div>
    <div class="form-group"><label for="email">E-mail</label><input id="email" type="email" name="email" required></div>
    <div class="form-group"><label for="telefone">Telefone</label><input id="telefone" type="tel" name="telefone" placeholder="(00) 00000-0000" required></div>
    <div class="form-group"><label for="senha">Senha</label><input id="senha" type="password" name="senha" required minlength="6"></div>
    <button class="btn btn-primary btn-submit" type="submit">Finalizar cadastro →</button>
  </form></section>
</main>
<%- include('../rodape.ejs') %>
