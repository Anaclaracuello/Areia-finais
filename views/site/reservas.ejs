<%- include('../cabecalho.ejs', { paginaAtiva: 'reservas' , tituloPagina: 'Minhas reservas' }) %>
  <main class="content-page">
    <section class="page-heading">
      <span class="eyebrow">SEUS PRÓXIMOS JOGOS</span>
      <h1>Minhas <em>reservas.</em></h1>
      <p>Informe o e-mail usado no cadastro para consultar suas reservas.</p>
    </section>
    <section class="lookup-card">
      <form action="/site/reservas" method="get" class="lookup-form">
        <div class="form-group">
          <label for="email">E-mail do cadastro</label>
          <input id="email" type="email" name="email" value="<%= email %>" placeholder="voce@email.com" required>
        </div>
        <button class="btn btn-primary" type="submit">Consultar →</button>
      </form>
    </section>
    <% if (email && !usuario) { %>
      <div class="notice">Não encontramos um usuário com esse e-mail.</div>
      <% } %>
        <% if (usuario) { %>
          <h2 class="section-title">Olá, <%= usuario.nome %>!</h2>
          <% if (!Reservas.length) { %>
            <div class="empty-state"><span>◷</span>
              <h2>Você ainda não tem reservas</h2>
              <p>Que tal marcar sua próxima partida?</p><a href="/site/nova-reserva" class="btn btn-primary">Fazer uma
                reserva</a>
            </div>
            <% } else { %>
              <div class="reservation-list">
                <% Reservas.forEach(r=> { %><article class="reservation-card">
                    <div class="reservation-date"><strong>
                        <%= new Date(r.data).toLocaleDateString('pt-BR', { day: '2-digit' }) %>
                      </strong><span>
                        <%= new Date(r.data).toLocaleDateString('pt-BR', { month: 'short' }) %>
                      </span></div>
                    <div class="reservation-details">
                      <h3>
                        <%= r.quadra ? r.quadra.localizacao : 'Quadra indisponível' %>
                      </h3>
                      <p>
                        <%= r.quadra ? (r.quadra.tipo==='coberta' ? 'Quadra coberta' : 'Quadra aberta' ) : '' %>
                      </p>
                    </div>
                    <div class="reservation-time"><strong>
                        <%= r.horario %>
                      </strong><small>Horário reservado</small></div>
                  </article>
                  <% }) %>
              </div>
              <% } %>
                <% } %>
  </main>
  <%- include('../rodape.ejs') %>